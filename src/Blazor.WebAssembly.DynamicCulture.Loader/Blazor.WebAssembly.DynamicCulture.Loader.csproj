<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <BunRuntimeDownload>true</BunRuntimeDownload>
    <BunVersionDownload>1.4.4</BunVersionDownload>
    <BunRuntimeDirectory>$(MSBuildProjectDirectory)/../../tools</BunRuntimeDirectory>
  </PropertyGroup>
  
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>ScarletKuro</Authors>
    <Description>Loads selected satellite resource assemblies in Blazor WebAssembly so cultures can be changed without reloading the page.</Description>
    <PackageReadmeFile>Loader.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ScarletKuro/Blazor.WebAssembly.DynamicCulture</RepositoryUrl>
    <PackageTags>Blazor, Culture, Localization, Localize, Resource, Resx, Globalization, Loader</PackageTags>
    <PackageIcon>dynamic-language-icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
  
  <ItemGroup>
    <None Include="..\..\docs\Loader.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\dynamic-language-icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>
	
  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <InternalsVisibleTo Include="Blazor.WebAssembly.DynamicCulture.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="6.0.4" />
    <PackageReference Include="Scarlet.Bun.MSBuild" Version="1.5.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <ItemGroup>
    <BunBeforeStaticWebAssets Include="build">
      <Arguments>./assets/SatelliteAssemblies.ts --outdir ./wwwroot --target browser --format esm --minify</Arguments>
    </BunBeforeStaticWebAssets>
  </ItemGroup>

</Project>
