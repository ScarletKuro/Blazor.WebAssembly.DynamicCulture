<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <BrowserTargetFramework Condition="'$(BrowserTargetFramework)' == ''">net10.0</BrowserTargetFramework>
    <BrowserFrameworkVersion Condition="'$(BrowserFrameworkVersion)' == ''">10.0.0</BrowserFrameworkVersion>
    <TargetFramework>$(BrowserTargetFramework)</TargetFramework>
    <RootNamespace>DynamicCultureBrowserTests</RootNamespace>
    <AssemblyName>DynamicCultureBrowserTests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Update="Microsoft.NETCore.App" RuntimeFrameworkVersion="$(BrowserFrameworkVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(BrowserFrameworkVersion)" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(BrowserFrameworkVersion)" PrivateAssets="all" />
    <ProjectReference Include="../../src/Blazor.WebAssembly.DynamicCulture/Blazor.WebAssembly.DynamicCulture.csproj" />
  </ItemGroup>
  <Target Name="WriteBrowserCoverageSourceMapping" AfterTargets="Build" Condition="'$(BrowserCoverage)' == 'true'">
    <!-- Coverlet needs the compiler's source-root mappings to resolve CI PDB paths. -->
    <MSBuild Projects="@(ProjectReference)"
             Targets="InitializeSourceRootMappedPaths"
             Properties="TargetFramework=$(TargetFramework)">
      <Output TaskParameter="TargetOutputs" ItemName="_BrowserCoverageSourceRoot" />
    </MSBuild>
    <ItemGroup>
      <_BrowserCoverageProject Include="@(_BrowserCoverageSourceRoot->'%(MSBuildSourceProjectFile)')" OriginalPath="%(Identity)" />
      <_BrowserCoverageMapping Include="@(_BrowserCoverageProject->'%(Identity)|%(OriginalPath)=%(MappedPath)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(TargetDir)browser-coverage-source-roots.txt"
                      Lines="@(_BrowserCoverageMapping)" Overwrite="true" Encoding="UTF-8" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
